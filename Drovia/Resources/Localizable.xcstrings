      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте её в Настройки Drovia → Папки"
          }
        }
      }
    },
    "Adding your Home folder covers everything inside it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Домашняя папка охватывает всё, что внутри неё."
